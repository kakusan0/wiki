{
  "name": "machikado-board",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "vite build && node tests/e2e.mjs",
    "deploy": "vite build && wrangler deploy",
    "dev:api": "vite build && wrangler dev --port 8787",
    "types": "wrangler types src/worker/worker-configuration.d.ts",
    "test:online": "vite build && node tests/online.mjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.11",
    "wrangler": "^4.0.0"
  }
}
