{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["src", "tests"],
  // Cloudflare 向けのファイルは tsconfig.worker.json で確認する（型の定義がブラウザと別のため）
  "exclude": ["src/worker/index.ts", "src/worker/room.ts", "src/worker/matchmaker.ts", "src/worker/worker-configuration.d.ts"]
}
