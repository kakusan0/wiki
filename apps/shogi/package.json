{
  "name": "shogi",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "e2e": "vite build && node tests/e2e.mjs",
    "test:online": "vite build && node tests/online.mjs",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "5.8.3",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "mp4-muxer": "^5.1.3",
    "webm-muxer": "^5.0.3"
  }
}
