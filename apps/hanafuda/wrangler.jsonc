{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hanafuda",
  "compatibility_date": "2026-10-01",
  // /api/* はオンライン対戦のサーバー（Worker）。ほかはビルドした画面をそのまま配信する
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  // 同じ IP から部屋を作るのは 1 分に 20 回まで
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "4401", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true }
}
